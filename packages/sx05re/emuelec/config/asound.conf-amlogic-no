pcm.!default {
    type dmix
    ipc_key 1024
    ipc_perm 0666
    slave {
        pcm "hw:0,2"
        rate 48000
        channels 2
        format S16_LE
        period_time 0
        period_size 2048
        buffer_size 8192
    }
    bindings {
        0 0
        1 1
    }
}

#Fixed volume 100%
ctl.!default {
    type empty
}

